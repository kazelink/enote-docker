{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eNote",
  "version": "1.0.0",
  "identifier": "com.enote.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/build-web.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
